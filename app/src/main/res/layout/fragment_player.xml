<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/slidingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.github.andreyasadchy.xtra.ui.view.PlayerLayout
            android:id="@+id/playerLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/black">

            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/aspectRatioFrameLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <SurfaceView
                    android:id="@+id/playerSurface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <androidx.media3.ui.SubtitleView
                android:id="@+id/subtitleView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/bufferingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <include
                android:id="@+id/playerControls"
                layout="@layout/player_layout" />

            <!-- explains the swipe gestures the first time fullscreen opens in a session -->
            <LinearLayout
                android:id="@+id/swipeHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="#99000000"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_brightness_medium_24" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_unfold_more_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/swipe_hint_brightness"
                        android:textColor="@android:color/white" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="96dp"
                    android:background="#55FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_expand_more_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/swipe_hint_minimize"
                        android:textColor="@android:color/white" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="96dp"
                    android:background="#55FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_volume_up_24" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_unfold_more_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/swipe_hint_volume"
                        android:textColor="@android:color/white" />

                </LinearLayout>

            </LinearLayout>

            <!-- brightness / volume level while swiping on the sides in fullscreen -->
            <LinearLayout
                android:id="@+id/swipeOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/swipe_overlay_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/swipeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no" />

                <ProgressBar
                    android:id="@+id/swipeProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="120dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:max="100"
                    android:progressBackgroundTint="#66FFFFFF"
                    android:progressTint="@android:color/white" />

                <TextView
                    android:id="@+id/swipeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minEms="2"
                    android:textColor="@android:color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/batteryOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/swipe_overlay_background"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:id="@+id/dragView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- sleep timer countdown, above dragView so it can be tapped to change the timer -->
            <LinearLayout
                android:id="@+id/sleepTimerOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/swipe_overlay_background"
                android:clickable="true"
                android:contentDescription="@string/sleep_timer"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_alarm_black_24"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/sleepTimerOverlayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.github.andreyasadchy.xtra.ui.view.PlayerLayout>

        <com.github.andreyasadchy.xtra.ui.view.SecondaryLayout
            android:id="@+id/secondaryLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?android:colorBackground">

            <!-- the streamer's channel and recent videos, like the YouTube watch page -->
            <LinearLayout
                android:id="@+id/channelPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/channelPanelHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:id="@+id/channelPanelImage"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/channelPanelName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/channelPanelInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/channelPanelOpen"
                        style="?attr/materialButtonTonalStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/player_channel_open" />

                </LinearLayout>

                <Button
                    android:id="@+id/watchVideo"
                    style="?attr/elevatedButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:text="@string/watch_video"
                    android:textAllCaps="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/channelPanelVideosTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:text="@string/player_recent_videos"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/channelPanelVideos"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

            </LinearLayout>

        </com.github.andreyasadchy.xtra.ui.view.SecondaryLayout>

    </FrameLayout>
</LinearLayout>
